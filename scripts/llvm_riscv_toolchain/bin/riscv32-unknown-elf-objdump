#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../../.." && pwd)"
xpack_objdump="$(find "${repo_root}/tools/xpack-riscv" -path '*/bin/riscv-none-elf-objdump' -type f -perm -u+x 2>/dev/null | sort | tail -n 1)"

if [[ -n "${xpack_objdump}" ]]; then
  exec "${xpack_objdump}" "$@"
fi

exec llvm-objdump "$@"
